# Required — used by orchestrator.py for LLM calls
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional — Claude chat model. Change it if a model is renamed or
# retired; no code change needed. Default shown.
CLAUDE_MODEL=claude-sonnet-5-5

# ── Retrieval (RAG) tuning, optional ──────────────────────────
# Minimum cosine similarity (0–1) a memory needs to be retrieved.
# Below it a memory counts as irrelevant: not put in the prompt and
# not reinforced. Tune with: python -m evaluation.retrieval_eval
RETRIEVAL_MIN_SCORE=0.30
# "true" lets the assistant's own past replies be retrieved as
# long-term memories. Default false (only the user's words count).
RETRIEVE_ASSISTANT_REPLIES=false

# Required — shared secret clients must send as the X-API-Key
# header on every route except GET / (health check). Orchestrator
# startup does not check this one, but api/main.py rejects every
# request with a 500 until it's set to something real.
MAEM_API_KEY=your-maem-api-key

# ── Application accounts (optional) ───────────────────────
# Login sessions are signed with MAEM_JWT_SECRET; if unset, a key
# derived from MAEM_API_KEY is used. Sessions last MAEM_TOKEN_HOURS.
# MAEM_JWT_SECRET=change-me-to-a-long-random-string
MAEM_TOKEN_HOURS=12
# Accounts database (users, reminders, alerts). Defaults to
# maem_app.db next to the memory database.
# MAEM_APP_DB_PATH=./maem_app.db

# Comma-separated list of origins allowed to call the API from a
# browser (CORS). Defaults to localhost-only if unset — add your
# frontend's real origin(s) here for anything beyond local dev.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Caregiver email notifications (optional) ──────────────────
# If ENABLE_EMAIL_ALERTS is not "true", or any SMTP_* / ALERT_EMAIL_TO
# value below is missing, alerts are just logged instead of emailed —
# nothing breaks if you leave this section unset.
ENABLE_EMAIL_ALERTS=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL_FROM=your-email@gmail.com
ALERT_EMAIL_TO=caregiver@example.com

# Extra agent_ids to monitor for caregiver alerts. Every Alzheimer's
# account in the app is monitored automatically; this is for the
# older API-only demo users.
NOTIFY_AGENT_IDS=rajan

# ── Optional persistence / tuning ─────────────────────────────
# On-disk embedded Qdrant storage directory for semantic/vector
# memory. If a relative path is given, it's resolved against the
# project root (not whatever directory you happened to launch the
# process from) so it means the same place on every run. Leave
# this variable unset entirely and it still persists — the
# orchestrator defaults to ./qdrant_data at the project root. Set
# it to an empty string to explicitly opt OUT of persistence
# (in-memory only, lost on every restart — logs a warning). Point
# it at a real Qdrant server instead for a multi-process/production
# setup (requires a small code change in memory/semantic_memory.py).
QDRANT_STORAGE_PATH=./qdrant_data

# Episodic/SQLite memory database path. Same rule as above: if
# relative, it's resolved against the project root rather than the
# launching process's working directory, so restarts from a
# different shell/IDE/service config don't silently start a fresh,
# empty database. Optional — defaults to multi_agent_memory.db at
# the project root if unset.
MAEM_DB_PATH=./multi_agent_memory.db

# Per-agent decay-speed override, format "agent_id:multiplier,...".
# A multiplier > 1.0 makes that agent's memories decay/forget
# faster than normal (1.0) — useful for demoing forgetting behavior
# without waiting real time. Defaults to the same rajan:3.0 demo
# behavior that used to be hardcoded in memory/episodic_memory.py.
AGENT_DECAY_MULTIPLIERS=rajan:3.0
